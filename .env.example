# 复制为 .env 后填写。首次启动会写入 /app/data/config.json，之后以文件为准。
PORT=3002

# 各家上游 Key（留空 = 跳过该上游）
GROQ_API_KEY=
LLM7_API_KEY=
KILO_API_KEY=
NVIDIA_API_KEY=
POLLINATIONS_API_KEY=
AIHORDE_API_KEY=

# 网关自身安全（强烈建议都设）
ACCESS_KEY=          # 客户端调用时的密码
ADMIN_PASSWORD=      # 登录 /admin 后台的密码

# 上游优先级，逗号分隔
PROVIDER_ORDER=groq,llm7,kilo,nvidia,pollinations,aihorde
